<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<!-- 通用：启用插件 -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>通用</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>启用插件</string>
			<key>key</key>
			<string>Enabled</string>
			<key>defaults</key>
			<string>com.yangzhou.themecoreplus</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.yangzhou.themecoreplus.preferences-changed</string>
		</dict>
		<!-- 主题：选择主题 + 刷新图标 -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>主题</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>label</key>
			<string>选择主题</string>
			<key>detail</key>
			<string>TCThemeListController</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>刷新图标</string>
			<key>action</key>
			<string>refreshIcons</string>
		</dict>
		<!-- 底部：作者 + 越狱源（照 ThemeCorePrefs/Root.plist 的 PSFooterHyperlinkView 写法。
		     footerHyperlinkRange 是要变成蓝色的那一段（按 UTF-16 记账）：
		     "作者：yangzhou\n越狱源" —— 0..2「作者：」3..10「yangzhou」11 换行 12..14「越狱源」。 -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerAlignment</key>
			<integer>1</integer>
			<key>footerCellClass</key>
			<string>PSFooterHyperlinkView</string>
			<key>footerHyperlinkAction</key>
			<string>tcOpenRepository:</string>
			<key>footerHyperlinkRange</key>
			<string>{12, 3}</string>
			<key>footerText</key>
			<string>作者：yangzhou
越狱源</string>
			<key>headerFooterHyperlinkButtonTitle</key>
			<string>作者：yangzhou
越狱源</string>
		</dict>
	</array>
</dict>
</plist>
